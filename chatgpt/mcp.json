{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "finalcal": {
      "type": "streamable-http",
      "url": "https://finalcal.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["calendar:read"],
            "defaultScopes": ["calendar:read"]
          }
        }
      }
    }
  }
}
